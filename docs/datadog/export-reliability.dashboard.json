{
  "title": "Reframe \u2014 export reliability",
  "description": "Export outcomes from Reframe's browser RUM events (src/lib/exportTelemetry.ts). Success rate = export_succeeded / (export_succeeded + export_failed); cancellations are excluded. Treat groups with few finished exports as noise. Setup and facets: docs/DATADOG.md. Release = commit SHA (@version).",
  "layout_type": "ordered",
  "template_variables": [
    {
      "name": "env",
      "prefix": "env",
      "available_values": [
        "production",
        "preview"
      ],
      "default": "production"
    }
  ],
  "widgets": [
    {
      "definition": {
        "title": "Export success rate (cancellations excluded)",
        "type": "query_value",
        "precision": 1,
        "custom_unit": "%",
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "data_source": "rum",
                "name": "succeeded",
                "indexes": [
                  "*"
                ],
                "compute": {
                  "aggregation": "count"
                },
                "search": {
                  "query": "@type:action service:reframe $env @action.target.name:export_succeeded"
                },
                "group_by": []
              },
              {
                "data_source": "rum",
                "name": "failed",
                "indexes": [
                  "*"
                ],
                "compute": {
                  "aggregation": "count"
                },
                "search": {
                  "query": "@type:action service:reframe $env @action.target.name:export_failed"
                },
                "group_by": []
              }
            ],
            "formulas": [
              {
                "formula": "100 * succeeded / (succeeded + failed)"
              }
            ]
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Finished exports (sample size)",
        "type": "query_value",
        "precision": 0,
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "data_source": "rum",
                "name": "succeeded",
                "indexes": [
                  "*"
                ],
                "compute": {
                  "aggregation": "count"
                },
                "search": {
                  "query": "@type:action service:reframe $env @action.target.name:export_succeeded"
                },
                "group_by": []
              },
              {
                "data_source": "rum",
                "name": "failed",
                "indexes": [
                  "*"
                ],
                "compute": {
                  "aggregation": "count"
                },
                "search": {
                  "query": "@type:action service:reframe $env @action.target.name:export_failed"
                },
                "group_by": []
              }
            ],
            "formulas": [
              {
                "formula": "succeeded + failed"
              }
            ]
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Export outcomes over time",
        "type": "timeseries",
        "show_legend": true,
        "requests": [
          {
            "response_format": "timeseries",
            "display_type": "bars",
            "queries": [
              {
                "data_source": "rum",
                "name": "succeeded",
                "indexes": [
                  "*"
                ],
                "compute": {
                  "aggregation": "count"
                },
                "search": {
                  "query": "@type:action service:reframe $env @action.target.name:export_succeeded"
                },
                "group_by": []
              },
              {
                "data_source": "rum",
                "name": "failed",
                "indexes": [
                  "*"
                ],
                "compute": {
                  "aggregation": "count"
                },
                "search": {
                  "query": "@type:action service:reframe $env @action.target.name:export_failed"
                },
                "group_by": []
              },
              {
                "data_source": "rum",
                "name": "cancelled",
                "indexes": [
                  "*"
                ],
                "compute": {
                  "aggregation": "count"
                },
                "search": {
                  "query": "@type:action service:reframe $env @action.target.name:export_cancelled"
                },
                "group_by": []
              }
            ],
            "formulas": [
              {
                "formula": "succeeded",
                "alias": "Succeeded"
              },
              {
                "formula": "failed",
                "alias": "Failed"
              },
              {
                "formula": "cancelled",
                "alias": "Cancelled by the user"
              }
            ]
          }
        ]
      }
    },
