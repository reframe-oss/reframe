                "search": {
                  "query": "service:reframe $env @type:action @action.target.name:export_failed"
                },
                "group_by": [
                  {
                    "facet": "version",
                    "limit": 8,
                    "sort": {
                      "aggregation": "count",
                      "order": "desc"
                    }
                  }
                ]
              },
              {
                "data_source": "rum",
                "name": "started",
                "indexes": [
                  "*"
                ],
                "compute": {
                  "aggregation": "count"
                },
                "search": {
                  "query": "service:reframe $env @type:action @action.target.name:export_started"
                },
                "group_by": [
                  {
                    "facet": "version",
                    "limit": 8,
                    "sort": {
                      "aggregation": "count",
                      "order": "desc"
                    }
                  }
                ]
              }
            ],
            "formulas": [
              {
                "formula": "100 * ok / started",
                "alias": "Started \u2192 succeeded (%)"
              },
              {
                "formula": "100 * ok / (ok + bad)",
                "alias": "Success, cancellations excluded (%)"
              },
              {
                "formula": "started",
                "alias": "Exports started"
              }
            ]
          }
        ]
      }
