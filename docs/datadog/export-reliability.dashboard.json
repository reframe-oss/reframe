    {
      "definition": {
        "title": "Release comparison: export success rate by version",
        "type": "query_table",
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "data_source": "rum",
                "name": "ok",
                "indexes": [
                  "*"
                ],
                "compute": {
                  "aggregation": "count"
                },
                "search": {
                  "query": "service:reframe $env @type:action @action.target.name:export_succeeded"
                },
                "group_by": [
                  {
                    "facet": "version",
                    "limit": 8,
                    "sort": {
                      "aggregation": "count",
                      "order": "desc"
                    }
                  }
                ]
              },
              {
                "data_source": "rum",
                "name": "bad",
                "indexes": [
                  "*"
                ],
                "compute": {
